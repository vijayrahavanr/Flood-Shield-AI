# ============================================================================
# FLOODSHIELD AI - ENVIRONMENT CONFIGURATION (.env.example)
# Team Name: Digital Pioneer
# Copy this file to .env and customize as needed.
# The application runs out-of-the-box in Demo/Fallback mode without paid keys.
# ============================================================================

# Application Settings
APP_NAME="FLOODSHIELD AI – Flood Prediction and Post-Flood Health Protection"
APP_ENV=development
APP_PORT=8000
TEAM_NAME="Digital Pioneer"
DEBUG=true

# Security & JWT Authentication
JWT_SECRET_KEY=floodshield-ai-super-secret-jwt-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Uses PostgreSQL when configured; automatically falls back to local SQLite if unset or unreachable
# Example PostgreSQL: postgresql://postgres:postgres@localhost:5432/floodshield_db
DATABASE_URL=sqlite:///./floodshield.db
POSTGRES_FALLBACK_TO_SQLITE=true

# External Weather & Climate APIs (Optional - Mock/Demo adapters active when empty)
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# River & Hydrological Telemetry APIs (Optional - Mock/Demo adapters active when empty)
CWC_WATER_LEVEL_API_KEY=
USGS_WATER_SERVICES_URL=https://waterservices.usgs.gov/nwis/iv/

# Remote Sensing / Satellite APIs (Optional - Copernicus Sentinel-1/2 & NASA Earthdata)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
NASA_EARTHDATA_TOKEN=
USE_MOCK_EXTERNAL_APIS=true

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEFAULT_LAT=10.9601
VITE_DEFAULT_LNG=78.0766
